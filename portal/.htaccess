RewriteEngine On
RewriteBase /

# 1. If an actual file exists, serve it directly without rewriting
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Cloudflare Edge Cache & CORS Headers for Static, Sitemap & PDF Streams
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/(pdf|stream_pdf\.php|book/|sitemaps/)#"
    Header set CDN-Cache-Control "public, max-age=31536000, immutable"
    Header set Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable"
</IfModule>

# Sovereign DOI & Handle Resolver Gateway: /doi/10.1007/s1m-nemer.0000004 or /doi/12345
RewriteRule ^doi/(.*)$ doi.php?doi=$1 [L,QSA]
RewriteRule ^doi/?$ doi.php [L,QSA]

# OAI-PMH 2.0 Global Library Harvesting Repository: /oai
RewriteRule ^oai/?$ oai.php [L,QSA]

# Academic Citation & Library of Congress MARC21 Export: /cite/12345
RewriteRule ^cite/([0-9]+)(/.*)?$ cite.php?id=$1 [L,QSA]
RewriteRule ^cite/?$ cite.php [L,QSA]

# Live Cryptographic Merkle Proof & Forensic Audit Lab: /audit/12345 or /api/verify/12345
RewriteRule ^audit/([0-9]+)(/.*)?$ audit.php?id=$1 [L,QSA]
RewriteRule ^audit/?$ audit.php [L,QSA]
RewriteRule ^api/verify/([0-9]+)(/.*)?$ audit.php?id=$1&format=json [L,QSA]
RewriteRule ^api/verify/?$ audit.php?format=json [L,QSA]

# Certificate of Authenticity Generator Route: /certificate/12345
RewriteRule ^certificate/([0-9]+)(/.*)?$ certificate.php?id=$1 [L,QSA]

# Instant 200-Page PDF Streamer Routes: /pdf/12345 or /pdf/12345/filename.pdf
RewriteRule ^pdf/([0-9]+)(/.*)?$ stream_pdf.php?id=$1 [L,QSA]

# Sitemap Index, 78-Language Sitemap & 20 Book Shards fallback
RewriteRule ^sitemap_index\.xml$ sitemap.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^sitemaps/sitemap_languages_78\.xml$ sitemap.php?type=langs [L,QSA]
RewriteRule ^sitemaps/sitemap_books_([0-9]+)\.xml$ sitemap.php?shard=$1 [L,QSA]

# Clean 78-Language Portal Routes: /lang/ar, /lang/en, /lang/zh-CN, etc.
RewriteRule ^lang/([a-zA-Z\-]+)/?$ index.php?lang=$1 [L,QSA]

# Clean SEO Book Landing Pages: /book/12345 or /book/12345/any-slug
RewriteRule ^book/([0-9]+)(/.*)?$ book.php?id=$1 [L,QSA]
RewriteRule ^verify$ book.php [L,QSA]

# Official Guinness & Global Adjudication Portal
RewriteRule ^guinness/?$ guinness.php [L,QSA]
RewriteRule ^adjudication/?$ guinness.php [L,QSA]

# Clean Dossier PDF Routes
RewriteRule ^guinness-dossier\.pdf$ guinness_dossier.pdf [L]
RewriteRule ^institutions-dossier\.pdf$ institutions_dossier.pdf [L]

# Default DirectoryIndex
DirectoryIndex index.php index.html
